# ===================================================================
# TaskFlow — Frontend Production Environment Variables
# ===================================================================
# These are baked into the build at `npm run build` time by Vite.
#
# ⚠️  IMPORTANT: Replace the URLs below with your actual deployed
#     backend Render Web Service URL BEFORE building for production.
#
# If the frontend is served by the backend (monolith), you can
# leave these commented out — the code falls back to same-origin.
# ===================================================================

# Backend API base URL (must include /api suffix)
VITE_API_URL=https://taskflow-1-vi32.onrender.com/api

# Socket.IO server URL (backend root, no /api)
VITE_SOCKET_URL=https://taskflow-1-vi32.onrender.com
